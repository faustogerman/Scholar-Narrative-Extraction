# Copy this file to `.env` and fill in your key.
# The app loads it automatically on startup.
#
# Used for the live OpenAI calls: query embedding, endpoint embeddings,
# query decomposition, and the narrative summary. Retrieval, graph
# construction, path finding, and the landscape projection run locally
# from the pre-computed embeddings.
OPENAI_API_KEY=your-openai-api-key-here
